# Copy to .env to override. Every value below is also the compose default,
# so `docker compose up` works with no .env file at all.

# ---- Kafka ----
KAFKA_BOOTSTRAP=kafka:9092          # in-network address (host uses localhost:29092)
TOPIC_TRANSACTIONS=transactions
TOPIC_ALERTS=fraud-alerts
TOPIC_PARTITIONS=3                  # >1 so keyed-by-card partitioning is real

# ---- Producer ----
EVENTS_PER_SEC=20                   # sustained transaction rate
NUM_CARDS=500
SEED=42                             # fixed seed => reproducible anomaly labels
RUN_SECONDS=0                        # 0 = run forever
ANOMALY_RATE=0.02                   # share of events that start an injected anomaly
LABELS_PATH=/data/labels.jsonl      # ground truth for scripts/evaluate.py

# ---- Fraud rules ----
VELOCITY_WINDOW_SEC=60
VELOCITY_MAX_TXNS=5                 # alert when a card exceeds this inside the window
AMOUNT_THRESHOLD_CAD=5000
TRAVEL_WINDOW_SEC=600               # same card, two countries inside 10 min
WATERMARK_LATENESS_SEC=5

# ---- Postgres ----
POSTGRES_DB=fraud
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
